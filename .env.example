# Copy this file to .env before running Docker Compose.
# Replace every demo secret before sharing or deploying the stack.
JWT_SECRET=replace-with-jwt-secret-at-least-32-characters
TICKET_SIGNING_KEY=replace-with-ticket-signing-key-at-least-32-chars
WALLET_INTERNAL_API_KEY=replace-with-wallet-key-at-least-32-characters
AUTH_INTERNAL_API_KEY=replace-with-auth-key-at-least-32-characters
WAITING_ROOM_INTERNAL_API_KEY=replace-with-waiting-room-key-at-least-32
TICKETING_INTERNAL_API_KEY=replace-with-ticketing-key-at-least-32-chars
INVENTORY_BOOKING_INTERNAL_API_KEY=replace-with-inventory-key-at-least-32

# Optional SMS provider settings. Leave blank to use the local OTP demo flow.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
OTP_EXPOSE_CODE=true

AUTH_RATE_REPLENISH=5
AUTH_RATE_BURST=10
DEFAULT_RATE_REPLENISH=30
DEFAULT_RATE_BURST=60
FRONTEND_PORT=4173
